    {
      "name": "airos-firmware",
      "wave": 2,
      "create": "import",
      "description": "Firmware air/OS images ship, from linux-firmware at pinned commits (Bluetooth for Intel/Realtek/MediaTek, MediaTek MT7921/MT7922 Wi-Fi, Mali CSF GPU), with their licences",
      "branch": "airos",
      "patches": [
        {
          "git": "https://git.kernel.org/pub/scm/linux/kernel/git/firmware/linux-firmware.git",
          "commit": "3b128b6069267b60a46a4074c383183177ee6e6d",
          "paths": [
            "/intel/ibt-*",
            "/rtl_bt/*",
            "/mediatek/BT_RAM_CODE_MT79*",
            "/mediatek/WIFI_MT79*",
            "/mediatek/WIFI_RAM_CODE_MT79*",
            "/LICENCE.ibt_firmware",
            "/LICENCE.rtlwifi_firmware.txt",
            "/LICENCE.mediatek",
            "/WHENCE"
          ],
          "message": "linux-firmware 20240318 (3b128b60): Intel, Realtek and MediaTek Bluetooth, MediaTek MT7921/MT7922 Wi-Fi\n\nThe same release as Ubuntu's linux-firmware 20240318.git3b128b60, which the\nworkstation-built firmware packages were made from."
        },
        {
          "git": "https://git.kernel.org/pub/scm/linux/kernel/git/firmware/linux-firmware.git",
          "commit": "eeccccbe83daf22e1931e3557ba05b2c02427e4e",
          "paths": [
            "/arm/mali/arch10.8/*",
            "/LICENCE.mali_csffw*"
          ],
          "message": "linux-firmware eeccccbe: Mali CSF GPU firmware (arch10.8, RK3588)"
        },
        {
          "git": "https://git.kernel.org/pub/scm/linux/kernel/git/firmware/linux-firmware.git",
          "commit": "eeccccbe83daf22e1931e3557ba05b2c02427e4e",
          "paths": [
            "/intel/ibt-0093-*",
            "/intel/ibt-00a0-*",
            "/intel/ibt-0190-*",
            "/intel/ibt-1190-*",
            "/rtl_bt/rtl8723b_config.bin",
            "/rtl_bt/rtl8723bs_config*.bin",
            "/rtl_bt/rtl8723cs_xx_*",
            "/rtl_bt/rtl8821a_config.bin",
            "/rtl_bt/rtl8922au_*"
          ],
          "message": "Newer Bluetooth chips from linux-firmware eeccccbe\n\nIntel BE200/BE201/AX211-class (ibt-0093, -00a0, -0190, -1190) and Realtek\nRTL8723B/BS/CS, RTL8821A and RTL8922AU files that Ubuntu's linux-firmware\nupdates added after 20240318. Every file present in 3b128b60 (the AX210's\nibt-0041-0041 among them, as tested on the ROCK 5) keeps that version."
        }
      ],
      "used_by": "firmware packages and the Mali firmware in all images (deps/recipes/firmware.sh)"
    },
